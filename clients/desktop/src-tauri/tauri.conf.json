{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PichaLite",
  "version": "0.1.0",
  "identifier": "ke.co.pichalite.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label":"main", "title":"PichaLite — Your photos. Lighter.", "width":1100, "height":800, "minWidth":720, "minHeight":600 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"], "shortDescription":"Private, on-device photo compression", "windows": { "nsis": { "installMode":"currentUser" } } }
}
